{
  "name": "ElPopconfirm",
  "props": {
    "title": {
      "value": "",
      "description": "Title",
      "default": "—",
      "type": "string",
      "description_zh": "标题",
      "required": true
    },
    "confirm-button-text": {
      "value": "",
      "description": "Confirm button text",
      "default": "—",
      "type": "string",
      "description_zh": "确认按钮文字"
    },
    "cancel-button-text": {
      "value": "",
      "description": "Cancel button text",
      "default": "—",
      "type": "string",
      "description_zh": "取消按钮文字"
    },
    "confirm-button-type": {
      "value": [
        "primary",
        "success",
        "warning",
        "danger",
        "info",
        "text"
      ],
      "description": "Confirm button type",
      "default": "primary",
      "type": "string",
      "description_zh": "确认按钮类型"
    },
    "cancel-button-type": {
      "value": [
        "primary",
        "success",
        "warning",
        "danger",
        "info",
        "text"
      ],
      "description": "Cancel button type",
      "default": "text",
      "type": "string",
      "description_zh": "取消按钮类型"
    },
    "icon": {
      "value": "",
      "description": "Icon Component",
      "default": "QuestionFilled",
      "type": "string | Component",
      "description_zh": "图标"
    },
    "icon-color": {
      "value": "",
      "description": "Icon color",
      "default": "#f90",
      "type": "string",
      "description_zh": "Icon 颜色"
    },
    "hide-icon": {
      "value": "",
      "description": "is hide Icon",
      "default": "false",
      "type": "boolean",
      "description_zh": "是否隐藏 Icon"
    },
    ":hide-after": {
      "value": "",
      "description": "delay of disappear, in millisecond",
      "default": "200",
      "type": "number",
      "description_zh": "关闭时的延迟"
    },
    "teleported": {
      "value": "",
      "description": "whether popconfirm is teleported to the body",
      "default": "true",
      "type": "boolean",
      "description_zh": "是否将 popover 的下拉列表插入至 body 元素"
    },
    "persistent": {
      "value": "",
      "description": "when popconfirm inactive and `persistent` is `false` , popconfirm will be destroyed",
      "default": "false",
      "type": "boolean",
      "description_zh": "当 popover 组件长时间不触发且 persistent 属性设置为 false 时, popover 将会被删除"
    },
    "width": {
      "value": "",
      "description": "popconfirm width, min width 150px",
      "default": "150",
      "type": "string | number",
      "description_zh": "弹层宽度，最小宽度 150px"
    }
  },
  "events": [
    {
      "name": "confirm",
      "description": "triggers when click confirm button",
