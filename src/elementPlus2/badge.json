      "description_zh": "显示值"
    },
    ":max": {
      "value": "",
      "description": "Maximum value, shows {max}+ when exceeded. Only works if value is a number",
      "default": "99",
      "type": "number",
      "description_zh": "最大值，超过最大值会显示 '{max}+'，要求 value 是 Number 类型"
    },
    "is-dot": {
      "value": "",
      "description": "If a little dot is displayed",
      "default": "false",
      "type": "boolean",
      "description_zh": "小圆点"
    },
    "hidden": {
      "value": "",
      "description": "Hidden badge",
      "default": "false",
      "type": "boolean",
      "description_zh": "隐藏 badge"
    },
    "type": {
      "value": [
        "primary",
        "success",
        "warning",
        "danger",
        "info"
