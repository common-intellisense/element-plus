{
  "name": "ElPopover",
  "props": {
    "trigger": {
      "value": [
        "click",
        "focus",
        "hover",
        "contextmenu"
      ],
      "description": "how the popover is triggered",
      "default": "hover",
      "type": "string",
      "description_zh": "触发方式"
    },
    "title": {
      "value": "",
      "description": "popover title",
      "default": "—",
      "type": "string",
      "description_zh": "标题",
      "required": true
    },
    "effect": {
      "value": [
        "dark",
        "light"
      ],
      "description": "Tooltip theme, built-in theme: `dark` / `light`",
      "default": "light",
      "type": "string",
      "description_zh": "Tooltip 主题，Element Plus 内置了 dark / light 两种主题"
    },
    "content": {
      "value": "",
      "description": "popover content, can be replaced with a default `slot`",
      "default": "",
      "type": "string",
      "description_zh": "显示的内容，也可以通过 `slot` 传入 DOM"
    },
    "width": {
      "value": "",
      "description": "popover width",
      "default": "150",
      "type": "string | number",
      "description_zh": "宽度"
    },
    "placement": {
      "value": [
        "top",
        "top-start",
        "top-end",
        "bottom",
        "bottom-start",
        "bottom-end",
        "left",
        "left-start",
        "left-end",
        "right",
        "right-start",
        "right-end"
      ],
      "description": "popover placement",
      "default": "bottom",
      "type": "string",
      "description_zh": "出现位置"
    },
    "disabled": {
      "value": "",
      "description": "whether Popover is disabled",
      "default": "false",
      "type": "boolean",
      "description_zh": "Popover 是否可用"
    },
    ":v-model:visible": {
      "value": "",
      "description": "whether popover is visible",
      "default": "null",
      "type": "boolean | null",
      "description_zh": "状态是否可见"
    },
    "offset": {
      "value": "",
      "description": "popover offset, `Popover` is built with `Tooltip`, offset of `Popover` is `undefined`, but offset of `Tooltip` is 12",
      "default": "undefined",
      "type": "number",
      "description_zh": "出现位置的偏移量"
    },
    "transition": {
      "value": "",
      "description": "popover transition animation, the default is el-fade-in-linear",
      "default": "—",
      "type": "string",
      "description_zh": "定义渐变动画"
    },
    "show-arrow": {
      "value": "",
      "description": "whether a tooltip arrow is displayed or not. For more info, please refer to [ElPopper](https://github.com/element-plus/element-plus/tree/dev/packages/components/popper)",
      "default": "true",
      "type": "boolean",
      "description_zh": "是否显示 Tooltip 箭头， 欲了解更多信息，请参考 ElPopper"
    },
    ":popper-options": {
      "value": "",
      "description": "parameters for [popper.js](https://popper.js.org/docs/v2/)",
      "default": "{modifiers: [{name: 'computeStyles',options: {gpuAcceleration: false}}]}",
      "type": "object",
      "description_zh": "[popper.js](https://popper.js.org/docs/v2/) 的参数"
    },
    "popper-class": {
      "value": "",
      "description": "custom class name for popover",
      "default": "—",
      "type": "string",
      "description_zh": "为 popper 添加类名"
    },
    "popper-style": {
      "value": "",
      "description": "custom style for popover",
      "default": "—",
      "type": "string | object",
      "description_zh": "为 popper 自定义样式"
    },
    ":show-after": {
      "value": "",
      "description": "delay of appearance, in millisecond",
      "default": "0",
      "type": "number",
      "description_zh": "在触发后多久显示内容，单位毫秒"
    },
    ":hide-after": {
      "value": "",
      "description": "delay of disappear, in millisecond",
      "default": "200",
      "type": "number",
      "description_zh": "延迟关闭，单位毫秒"
    },
    ":auto-close": {
      "value": "",
      "description": "timeout in milliseconds to hide tooltip",
      "default": "0",
      "type": "number",
      "description_zh": "tooltip 出现后自动隐藏延时，单位毫秒"
    },
    "tabindex": {
      "value": "",
      "description": "[tabindex](https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/tabindex) of Popover",
      "default": "0",
      "type": "number | string",
      "description_zh": "Popover 组件的 [tabindex](https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/tabindex)"
    },
    "teleported": {
      "value": "",
      "description": "whether popover dropdown is teleported to the body",
      "default": "true",
      "type": "boolean",
      "description_zh": "是否将 popover 的下拉列表插入至 body 元素"
    },
    "persistent": {
      "value": "",
      "description": "when popover inactive and `persistent` is `false` , popover will be destroyed",
      "default": "true",
      "type": "boolean",
      "description_zh": "当 popover 组件长时间不触发且 persistent 属性设置为 false 时, popover 将会被删除"
    },
    "virtual-triggering": {
      "value": "",
      "description": "Indicates whether virtual triggering is enabled",
      "default": "—",
      "type": "boolean",
      "description_zh": "是否启用虚拟触发"
    }
  },
  "events": [
    {
      "name": "show",
      "description": "triggers when popover shows",
      "params": "() => void",
      "description_zh": "显示时触发",
      "value": ""
    },
    {
      "name": "before-enter",
      "description": "triggers when the entering transition before",
      "params": "() => void",
      "description_zh": "显示动画播放前触发",
      "value": ""
    },
    {
      "name": "after-enter",
      "description": "triggers when the entering transition ends",
      "params": "() => void",
      "description_zh": "显示动画播放完毕后触发",
      "value": ""
    },
    {
      "name": "hide",
      "description": "triggers when popover hides",
      "params": "() => void",
      "description_zh": "隐藏时触发",
      "value": ""
    },
    {
      "name": "before-leave",
      "description": "triggers when the leaving transition before",
      "params": "() => void",
      "description_zh": "隐藏动画播放前触发",
      "value": ""
    },
    {
      "name": "after-leave",
      "description": "triggers when the leaving transition ends",
      "params": "() => void",
      "description_zh": "隐藏动画播放完毕后触发",
      "value": ""
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "text content of popover",
      "description_zh": "Popover 内容"
    },
    {
      "name": "reference",
      "description": "HTML element that triggers popover",
      "description_zh": "触发 Popover 显示的 HTML 元素"
    }
  ],
  "exposed": [
    {
      "name": "hide",
      "description": "hide popover",
      "description_zh": "隐藏 Popover",
      "detail": "() => void"
    }
  ],
  "link": "https://element-plus.org/en-US/component/popover.html",
  "link_zh": "https://element-plus.org/zh-CN/component/popover.html",
  "methods": []
}
