{
  "name": "ElTag",
  "props": {
    "type": {
      "value": [
        "primary",
        "success",
        "info",
        "warning",
        "danger"
      ],
      "description": "type of Tag",
      "default": "primary",
      "type": "string",
      "description_zh": "标签类型"
    },
    "closable": {
      "value": "",
      "description": "whether Tag can be removed",
      "default": false,
      "type": "boolean",
      "description_zh": "是否可关闭"
    },
    "disable-transitions": {
      "value": "",
      "description": "whether to disable animations",
      "default": false,
      "type": "boolean",
      "description_zh": "是否禁用渐变动画"
    },
    "hit": {
      "value": "",
      "description": "whether Tag has a highlighted border",
      "default": false,
      "type": "boolean",
      "description_zh": "是否有边框描边"
    },
    "color": {
      "value": "",
      "description": "background color of the Tag",
      "default": "—",
      "type": "string",
      "description_zh": "标签背景色"
    },
    "size": {
      "value": [
        "large",
        "default",
        "small"
      ],
      "description": "size of Tag",
      "default": "—",
      "type": "string",
      "description_zh": "标签尺寸"
    },
    "effect": {
      "value": [
        "dark",
        "light",
        "plain"
      ],
      "description": "theme of Tag",
      "default": "light",
      "type": "string",
      "description_zh": "标签主题"
    },
    "round": {
      "value": "",
      "description": "whether Tag is rounded",
      "default": false,
      "type": "boolean",
      "description_zh": "是否为圆形标签"
    }
  },
  "events": [
    {
      "name": "click",
      "description": "triggers when Tag is clicked",
      "params": "(evt: MouseEvent) => void",
      "description_zh": "点击标签时触发的事件",
      "value": ""
    },
    {
      "name": "close",
      "description": "triggers when Tag is removed",
      "params": "(evt: MouseEvent) => void",
      "description_zh": "关闭标签时触发的事件",
      "value": ""
    }
  ],
  "methods": [],
  "slots": [
    {
      "name": "default",
      "description": "customize default content",
      "description_zh": "自定义默认内容"
    }
  ],
  "link": "https://element-plus.org/en-US/component/tag.html",
  "link_zh": "https://element-plus.org/zh-CN/component/tag.html"
}
