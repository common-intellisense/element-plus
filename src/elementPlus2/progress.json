{
  "name": "ElProgress",
  "props": {
    ":percentage": {
      "value": "",
      "description": "Percentage (required)",
      "default": "0",
      "type": "number",
      "description_zh": "百分比（必填）",
      "required": true
    },
    "type": {
      "value": [
        "line",
        "circle",
        "dashboard"
      ],
      "description": "The type of progress bar",
      "default": "line",
      "type": "string",
      "description_zh": "进度条类型"
    },
    ":stroke-width": {
      "value": "",
      "description": "The width of progress bar",
      "default": "6",
      "type": "number",
      "description_zh": "进度条的宽度，单位 px"
    },
    "text-inside": {
      "value": "",
      "description": "Whether to place the percentage inside progress bar, only works when type is 'line'",
      "default": "false",
      "type": "boolean",
      "description_zh": "进度条显示文字内置在进度条内（只在 type=line 时可用）"
    },
    "status": {
      "value": [
        "success",
        "exception",
        "warning"
      ],
      "description": "The current status of progress bar",
      "default": "—",
      "type": "string",
      "description_zh": "进度条当前状态"
    },
    "indeterminate": {
      "value": "",
      "description": "Set indeterminate progress",
      "default": "false",
      "type": "boolean",
      "description_zh": "设置不确定进度"
    },
    ":duration": {
      "value": "",
      "description": "Control the animation duration of indeterminate progress or striped flow progress",
      "default": "3",
      "type": "number",
      "description_zh": "控制不确定进度或条纹流进度的动画持续时间"
    },
    "color": {
      "value": "",
      "description": "Background color of progress bar. Overrides status prop",
      "default": "''",
      "type": "string | function(percentage: number) => string | { color: string; percentage: number }[]",
      "description_zh": "进度条背景色（会覆盖 status 状态颜色）"
    },
    ":width": {
      "value": "",
      "description": "The canvas width of circle progress bar",
      "default": "126",
      "type": "number",
      "description_zh": "环形进度条画布宽度（只在 type 为 circle 或 dashboard 时可用）"
    },
    "show-text": {
      "value": "",
      "description": "Whether to show percentage",
      "default": "true",
      "type": "boolean",
      "description_zh": "是否显示进度条文字内容"
    },
    "stroke-linecap": {
      "value": [
        "butt",
        "round",
        "square"
      ],
      "description": "Circle/dashboard type shape at the end path",
      "default": "round",
      "type": "string",
      "description_zh": "circle/dashboard 类型路径两端的形状"
    },
    ":format": {
      "value": "",
      "description": "Custom text format",
      "default": "—",
      "type": "function(percentage: number) => string",
      "description_zh": "指定进度条文字内容"
    },
    "striped": {
      "value": "",
      "description": "Stripe over the progress bar's color",
      "default": "false",
      "type": "boolean",
      "description_zh": "在进度条上设置条纹",
      "version": "2.3.4"
    },
    "striped-flow": {
      "value": "",
      "description": "Get the stripes to flow",
      "default": "false",
      "type": "boolean",
      "description_zh": "使条纹流动起来",
      "version": "2.3.4"
    }
  },
  "slots": [
    {
      "name": "default",
      "description": "Customized content",
      "description_zh": "自定义内容",
      "params": "{ percentage: number }"
    }
  ],
  "events": [],
  "link": "https://element-plus.org/en-US/component/progress.html",
  "link_zh": "https://element-plus.org/zh-CN/component/progress.html",
  "methods": []
}
