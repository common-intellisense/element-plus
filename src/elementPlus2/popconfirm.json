    {
      "name": "cancel",
      "description": "triggers when click cancel button",
      "params": "(e: MouseEvent) => void",
      "description_zh": "点击取消按钮时触发",
      "value": ""
    }
  ],
  "slots": [
    {
      "name": "reference",
      "description": "HTML element that triggers Popconfirm",
      "description_zh": "触发 Popconfirm 显示的 HTML 元素"
    },
    {
      "name": "actions",
      "description": "content of the Popconfirm footer",
      "description_zh": "Popconfirm 底部内容",
      "params": "{ confirm: (e: MouseEvent) => void, cancel: (e: MouseEvent) => void }",
      "version": "2.8.1"
    }
  ],
  "suggestions": [
    "el-button"
  ],
  "link": "https://element-plus.org/en-US/component/popconfirm.html",
