{
  "name": "ElAvatar",
  "props": {
    "icon": {
      "value": "",
      "description": "Representation type to icon, more info on icon component",
      "default": "—",
      "type": "string | Component",
      "description_zh": "设置头像的图标类型，参考 Icon 组件"
    },
    "size": {
      "value": [
        "large",
        "default",
        "small"
      ],
      "description": "Avatar size",
      "default": "default",
      "type": "number | string",
      "description_zh": "设置头像的大小"
    },
    "shape": {
      "value": [
        "circle",
        "square"
      ],
      "description": "Avatar shape",
      "default": "circle",
      "type": "string",
      "description_zh": "设置头像的形状"
    },
    "src": {
      "value": "",
      "description": "The source of the image for an image avatar",
      "default": "—",
      "type": "string",
      "description_zh": "图片头像的资源地址"
    },
    "srcSet": {
      "value": "",
      "description": "Native attribute srcset of image avatar",
      "default": "—",
      "type": "string",
      "description_zh": "以逗号分隔的一个或多个字符串列表表明一系列用户代理使用的可能的图像"
    },
    "alt": {
      "value": "",
      "description": "Native attribute alt of image avatar",
      "default": "—",
      "type": "string",
      "description_zh": "描述图像的替换文本"
    },
    "fit": {
      "value": [
        "fill",
        "contain",
        "cover",
        "none",
        "scale-down"
      ],
      "description": "Set how the image fit its container for an image avatar",
      "default": "cover",
      "type": "string",
      "description_zh": "当展示类型为图片的时候，设置图片如何适应容器框"
    }
  },
  "events": [
    {
      "name": "error",
      "description": "Trigger when image load error",
      "description_zh": "图片类头像加载失败的回调",
      "params": "(e: Event) => void"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "Customize avatar content",
      "description_zh": "自定义头像内容"
    }
  ],
  "methods": [],
  "link": "https://element-plus.org/en-US/component/avatar.html",
  "link_zh": "https://element-plus.org/zh-CN/component/avatar.html"
}
