{
  "name": "ElSteps",
  "props": {
    "space": {
      "value": "",
      "description": "the spacing of each step, will be responsive if omitted. Supports percentage.",
      "default": "",
      "type": "number | string",
      "description_zh": "每个 step 的间距，不填写将自适应间距。支持百分比。"
    },
    "direction": {
      "value": [
        "vertical",
        "horizontal"
      ],
      "description": "display direction",
      "default": "horizontal",
      "type": "string",
      "description_zh": "显示方向"
    },
    ":active": {
      "value": "",
      "description": "current activation step",
      "default": "0",
      "type": "number",
      "description_zh": "设置当前激活步骤"
    },
    "process-status": {
      "value": [
        "wait",
        "process",
        "finish",
        "error",
        "success"
      ],
      "description": "status of current step",
      "default": "process",
      "type": "string",
      "description_zh": "设置当前步骤的状态"
    },
    "finish-status": {
      "value": [
        "wait",
        "process",
        "finish",
        "error",
        "success"
      ],
      "description": "status of end step",
      "default": "finish",
      "type": "string",
      "description_zh": "设置结束步骤的状态"
    },
    "align-center": {
      "value": "",
      "description": "center title and description",
      "default": "false",
      "type": "boolean",
      "description_zh": "进行居中对齐"
    },
    "simple": {
      "value": "",
      "description": "whether to apply simple theme",
      "default": "false",
      "type": "boolean",
      "description_zh": "是否应用简洁风格"
    }
  },
  "events": [],
  "slots": [
    {
      "name": "default",
      "description": "customize default content",
      "description_zh": "自定义默认内容"
    }
  ],
  "suggestions": [
    "el-step"
  ],
  "link": "https://element-plus.org/en-US/component/steps.html",
  "link_zh": "https://element-plus.org/zh-CN/component/steps.html",
  "methods": []
}
