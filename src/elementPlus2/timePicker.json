    "Options": [
      {
        "name": "selectableRange",
        "description": "可选时间段，例如'18:30:00 - 20:30:00'或者传入数组['09:30:00 - 12:00:00', '14:30:00 - 18:30:00']",
        "description_zh": "可选时间段，例如'18:30:00 - 20:30:00'或者传入数组['09:30:00 - 12:00:00', '14:30:00 - 18:30:00']",
        "params": "string / array",
        "value": ""
      },
      {
        "name": "format",
        "description": "时间格式化(TimePicker)",
        "description_zh": "时间格式化(TimePicker)",
        "params": "string",
        "value": "'HH:mm:ss'"
      }
    ]
