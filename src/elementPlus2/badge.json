    ":badge-style": {
      "value": "",
      "description": "Custom style of badge",
      "default": "—",
      "type": "object",
      "description_zh": "自定义徽章的样式",
      "version": "2.7.1"
    },
    "badge-class": {
      "value": "",
      "description": "Custom class of badge",
      "default": "—",
      "type": "string",
      "description_zh": "自定义徽章的类名",
      "version": "2.7.1"
    }
