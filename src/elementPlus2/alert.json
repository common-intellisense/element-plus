{
  "name": "ElAlert",
  "props": {
    "title": {
      "value": "",
      "description": "alert title.",
      "default": "—",
      "type": "string",
      "description_zh": "标题"
    },
    "type": {
      "value": [
        "success",
        "warning",
        "info",
        "error"
      ],
      "description": "alert type.",
      "default": "info",
      "type": "string",
      "description_zh": "主题"
    },
    "description": {
      "value": "",
      "description": "descriptive text.",
      "default": "—",
      "type": "string",
      "description_zh": "辅助性文字。也可通过默认 slot 传入"
    },
    "closable": {
      "value": "",
      "description": "whether alert can be dismissed.",
      "default": "true",
      "type": "boolean",
      "description_zh": "是否可关闭"
    },
    "center": {
      "value": "",
      "description": "whether content is placed in the center.",
      "default": "false",
      "type": "boolean",
      "description_zh": "文字是否居中"
    },
    "close-text": {
      "value": "",
      "description": "customized close button text.",
      "default": "—",
      "type": "string",
      "description_zh": "关闭按钮自定义文本"
    },
    "show-icon": {
      "value": "",
      "description": "whether a type icon is displayed.",
      "default": "false",
      "type": "boolean",
      "description_zh": "是否显示图标"
    },
    "effect": {
      "value": [
        "light",
        "dark"
      ],
      "description": "theme style.",
      "default": "light",
      "type": "string",
      "description_zh": "选择提供的主题"
    }
  },
  "events": [
    {
      "name": "close",
      "description": "trigger when alert is closed.",
      "params": "(event: MouseEvent) => void",
      "description_zh": "关闭alert时触发的事件",
      "value": ""
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "content of the alert description.",
      "description_zh": "描述区域的内容"
    },
    {
      "name": "title",
      "description": "content of the alert title.",
      "description_zh": "标题的内容"
    }
  ],
  "link": "https://element-plus.org/en-US/component/alert.html",
  "link_zh": "https://element-plus.org/zh-CN/component/alert.html",
  "methods": []
}
