{
  "name": "ElTimeSelect",
  "props": {
    ":v-model": {
      "value": "",
      "description": "binding value",
      "default": "—",
      "type": "string",
      "description_zh": "绑定值",
      "required": true
    },
    "disabled": {
      "value": "",
      "description": "whether TimeSelect is disabled",
      "default": "false",
      "type": "boolean",
      "description_zh": "禁用"
    },
    "editable": {
      "value": "",
      "description": "whether the input is editable",
      "default": "true",
      "type": "boolean",
      "description_zh": "文本框可输入"
    },
    "clearable": {
      "value": "",
      "description": "whether to show clear button",
      "default": "true",
      "type": "boolean",
      "description_zh": "是否显示清除按钮"
    },
    "include-end-time": {
      "value": "",
      "description": "whether `end` is included in options",
      "default": "false",
      "type": "boolean",
      "version": "2.9.3",
      "description_zh": "是否包含结束时间"
    },
    "size": {
      "value": ["large", "default", "small"],
      "description": "size of Input",
      "default": "default",
      "type": "enum",
      "description_zh": "输入框尺寸"
    },
    "placeholder": {
      "value": "请选择",
      "description": "Placeholder content when not scoped",
      "default": "—",
      "type": "string",
      "description_zh": "非范围选择时的占位内容",
      "required": true,
      "$label": "请选择$label",
      "related": [
        "el-form-item.label"
      ]
    },
    "name": {
      "value": "",
      "description": "same as `name` in native input",
      "default": "—",
      "type": "string",
      "description_zh": "原生属性"
    },
    "effect": {
      "value": ["dark", "light"],
      "description": "Tooltip theme, built-in theme: `dark` / `light`",
      "default": "light",
      "type": "string | enum",
      "description_zh": "Tooltip 主题，内置主题：`dark` / `light`"
    },
    "prefix-icon": {
      "value": "",
      "description": "custom prefix icon component",
      "default": "Clock",
      "type": "string | Component",
      "description_zh": "自定义前缀图标组件"
    },
    "clear-icon": {
      "value": "",
      "description": "custom clear icon component",
      "default": "CircleClose",
      "type": "string | Component",
      "description_zh": "自定义清除图标组件"
    },
    "start": {
      "value": "",
      "description": "start time",
      "default": "09:00",
      "type": "string",
      "description_zh": "开始时间"
    },
    "end": {
      "value": "",
      "description": "end time",
      "default": "18:00",
      "type": "string",
      "description_zh": "结束时间"
    },
    "step": {
      "value": "",
      "description": "time step",
      "default": "00:30",
      "type": "string",
      "description_zh": "间隔时间"
    },
    "min-time": {
      "value": "",
      "description": "minimum time, any time before this time will be disabled",
      "default": "—",
      "type": "string",
      "description_zh": "最小时间，小于该时间的时间段将被禁用"
    },
    "max-time": {
      "value": "",
      "description": "maximum time, any time after this time will be disabled",
      "default": "—",
      "type": "string",
      "description_zh": "最大时间，大于该时间的时间段将被禁用"
    },
    "format": {
      "value": "",
      "description": "set format of time",
      "default": "HH:mm",
      "type": "string",
      "description_zh": "设置时间格式"
    },
    ":empty-values": {
      "value": "",
      "description": "empty values of component",
      "default": "—",
      "type": "array",
      "version": "2.7.0",
      "description_zh": "组件的空值"
    },
    "value-on-clear": {
      "value": "",
      "description": "clear return value",
      "default": "—",
      "type": "string | number | boolean | Function",
      "version": "2.7.0",
      "description_zh": "清除返回值"
    }
  },
  "methods": [
    {
      "name": "focus",
      "description": "Make input get focus",
      "params": "-",
      "description_zh": "使 input 获取焦点",
      "value": ""
    }
  ],
  "typeDetail": {
    "Options": [
      {
        "name": "start",
        "type": "string",
        "description": "开始时间",
        "default": "—"
      },
      {
        "name": "end",
        "type": "string",
        "description": "结束时间",
        "default": "—"
      },
      {
        "name": "step",
        "type": "string",
        "description": "间隔时间",
        "default": "—"
      },
      {
        "name": "minTime",
        "type": "string",
        "description": "最小时间，小于该时间的时间段将被禁用",
        "default": "—"
      },
      {
        "name": "maxTime",
        "type": "string",
        "description": "最大时间，大于该时间的时间段将被禁用",
        "default": "—"
      }
    ]
  },
  "events": [
    {
      "name": "change",
      "description": "triggers when user confirms the value",
      "params": "string",
      "type": "(value: string) => void",
      "description_zh": "用户确认选定的值时触发"
    },
    {
      "name": "blur",
      "description": "triggers when Input blurs",
      "params": "(event: FocusEvent) => void",
      "type": "Function",
      "description_zh": "当 input 失去焦点时触发"
    },
    {
      "name": "focus",
      "description": "triggers when Input focuses",
      "params": "(event: FocusEvent) => void",
      "type": "Function",
      "description_zh": "当 input 获得焦点时触发"
    },
    {
      "name": "clear",
      "description": "triggers when the clear icon is clicked in a clearable TimeSelect",
      "params": "-",
      "type": "() => void",
      "version": "2.7.7",
      "description_zh": "当可清除的 TimeSelect 中点击清除图标时触发"
    }
  ],
  "exposed": [
    {
      "name": "focus",
      "description": "focus the Input component",
      "detail": "() => void",
      "description_zh": "使 Input 组件获取焦点"
    },
    {
      "name": "blur",
      "description": "blur the Input component",
      "detail": "() => void",
      "description_zh": "使 Input 组件失去焦点"
    }
  ],
  "link": "https://element-plus.org/en-US/component/time-select.html",
  "link_zh": "https://element-plus.org/zh-CN/component/time-select.html"
}
